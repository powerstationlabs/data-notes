{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/powerstationlabs/data-notes/schema/station.schema.json",
  "title": "PowerStationLabs public station dataset",
  "description": "Source-backed specification slice published by PowerStationLabs. Values are null when the source did not state them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_version",
    "generated_at",
    "locale",
    "license",
    "catalog",
    "provenance_levels",
    "stations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}(\\.[0-9]+)?$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "locale": {
      "const": "en"
    },
    "license": {
      "const": "CC-BY-4.0"
    },
    "catalog": {
      "type": "string",
      "format": "uri"
    },
    "provenance_levels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/station"
      }
    }
  },
  "$defs": {
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "brand",
        "series",
        "name",
        "provenance_level",
        "verified_at",
        "specs",
        "provenance",
        "sources",
        "lifecycle_status"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "brand": {
          "type": "string",
          "minLength": 1
        },
        "series": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "provenance_level": {
          "enum": [
            "field_citation",
            "manual_extract"
          ]
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "specs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capacity",
            "power",
            "peak_power",
            "cycles",
            "solar_input",
            "ac_outlets",
            "usb_a_ports",
